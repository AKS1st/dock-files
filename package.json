{
  "name": "desk-files",
  "version": "0.1.0",
  "description": "File explorer feature plugin for desk: mounts a side-bar files panel (activity item 'files') that browses the active conversation's working directory through its own /wb-files host route. First dogfood of the workbench contract.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown -c tsdown.config.mjs",
    "check": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7",
    "desk": ">=0.1.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "desk": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "desk": "link:/home/zero/AgentX/plugins/desk",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
